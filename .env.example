# Local services
POSTGRES_DB=tradeops_hub
POSTGRES_USER=tradeops
POSTGRES_PASSWORD=change-me-for-local-only
POSTGRES_PORT=5432
DB_HOST=localhost
API_PORT=8081
WEB_PORT=3000
TRADEOPS_WEB_ALLOWED_ORIGIN=http://localhost:3000
# Set in the frontend process environment when overriding the default API URL.
NEXT_PUBLIC_API_BASE=http://localhost:8081/api/v1

# Local-only JWT configuration. Replace before any deployment.
JWT_ISSUER=tradeops-hub-local
JWT_SECRET=dHJhZGVvcHMtcG9ydGZvbGlvLWxvY2FsLXNlY3JldC1tdXN0LWJlLTMyLWJ5dGVzLW9yLW1vcmU=
JWT_EXPIRATION_MINUTES=60
SEED_DEMO_USERS=true

# Development-only deterministic fixture seed. Never use real source data.
FIXTURE_SEED=20260906

# Optional override for runtime-only verification. Set in the invoking shell;
# verify-runtime.ps1 does not load this file. The final gate uses its own local seed.
# VERIFY_LOCAL_PASSWORD=your-local-verification-password
