# Database (choose a strong local password; never commit .env)
POSTGRES_DB=tradeops_hub
POSTGRES_USER=tradeops
POSTGRES_PASSWORD=replace-this-password
POSTGRES_PORT=5432
DB_HOST=localhost
API_PORT=8081
WEB_PORT=3000

# Fixed owner, created only when absent. No default users or role editor.
OWNER_USERNAME=admin@tradeops.test
OWNER_INITIAL_PASSWORD=replace-this-owner-password
SESSION_TIMEOUT=30m
# Set true behind HTTPS in deployment. Local HTTP requires false.
SESSION_COOKIE_SECURE=false

# Next.js forwards browser requests to the API on the same origin.
API_PROXY_TARGET=http://127.0.0.1:8081
# Separate internal law service; blank disables connectivity. Never expose through NEXT_PUBLIC.
LAW_RAG_BASE_URL=http://127.0.0.1:8080
LAW_RAG_TIMEOUT_SECONDS=180
# Optional isolated build directory:
# NEXT_DIST_DIR=.next-verify

# Public BIS sources; download links are rediscovered each run.
BIS_GUIDE_URL=https://www.bis.gov/licensing/guidance-on-end-user-and-end-use-controls-and-us-person-controls
BIS_ALLOWED_HOSTS=bis.gov,www.bis.gov,media.bis.gov
BIS_STORAGE_PATH=../storage/bis
BIS_SCHEDULE_ENABLED=true
BIS_SCHEDULE_CRON=0 0 9 * * MON
BIS_SCHEDULE_ZONE=Asia/Seoul

# Runtime verification reads these from the process environment only.
# VERIFY_OWNER_USERNAME=owner@tradeops.test
# VERIFY_LOCAL_PASSWORD=set-for-isolated-verification
